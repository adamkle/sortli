{
  "expo": {
    "name": "sortli",
    "slug": "sortli",
    "scheme": "sortli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sortliIcon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sortli.app"
    },
    "android": {
      "icon": "./assets/sortliIcon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.sortli.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/sortliIcon_scaled.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#35597D"
      },
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "df5dbc8a-4a31-48ac-9d28-51e572d0c023"
      }
    },
    "owner": "sortliapp",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1E1B4B"
        }
      ]
    ]
  }
}
